# Copy to .env and fill in the required values.

# --- App ---
NODE_ENV=development
PORT=3000
# Set to true when running behind a reverse proxy (correct client IP for rate limiting)
TRUST_PROXY=false

# --- Database (required) ---
# Atlas:  mongodb+srv://<user>:<pass>@<cluster>/<db>
# Local:  mongodb://localhost:27017/media-library
MONGO_URI=mongodb+srv://<user>:<pass>@<cluster>/<db>

# --- JWT (secrets required) ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Uploads ---
UPLOAD_DIR=./uploads
# Bytes (default 5 MB)
MAX_FILE_SIZE=5242880

# --- Rate limiting ---
# Window in ms
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
# Stricter limit for /auth/login, /auth/register, /auth/refresh
THROTTLE_AUTH_LIMIT=10

# --- Admin seed (npm run seed:admin) ---
# Only read by the seed script, not by the app. Same password rules as
# registration (8+ chars, a letter and a digit). Re-running is safe; a changed
# password is applied and that admin's sessions are closed.
#   npm run seed:admin:dev      (from source)
#   npm run seed:admin          (after npm run build / in Docker)
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=ChangeMe123

# --- Docker Compose only (docker compose up) ---
# Inside the container MONGO_URI is replaced by the bundled mongo service.
# To use Atlas from Docker instead, set:
# DOCKER_MONGO_URI=mongodb+srv://<user>:<pass>@<cluster>/<db>
# Host port of the API (default 3000), e.g. when 3000 is already in use:
# API_PORT=3001
# Host port of the compose MongoDB, bound to 127.0.0.1 (default 27018):
# MONGO_HOST_PORT=27019
